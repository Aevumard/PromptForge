{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aevumard/PromptForge/blob/main/schemas/triage-state.v1.json",
  "title": "PromptForge Triage State v1",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "decision_id",
    "stage",
    "policy_version"
  ],
  "properties": {
    "schema_version": {
      "const": "triage-state.v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "admitted",
        "prioritized",
        "action_gated",
        "waiting_human",
        "executed",
        "observed",
        "closed"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_snapshot_id": {
      "type": ["string", "null"]
    },
    "parent_decision_id": {
      "type": ["string", "null"]
    },
    "priority": {
      "type": ["object", "null"],
      "required": ["urgency", "importance", "priority_band", "rationale"],
      "properties": {
        "urgency": {"type": "number", "minimum": 0, "maximum": 1},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "priority_band": {"type": "string", "minLength": 1},
        "rationale": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "action_decision": {
      "type": ["object", "null"]
    },
    "human_review_reason": {
      "type": ["string", "null"]
    },
    "outcome": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": false
}
