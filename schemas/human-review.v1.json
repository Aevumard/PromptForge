{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aevumard/PromptForge/blob/main/schemas/human-review.v1.json",
  "title": "PromptForge Human Review v1",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "reviewer_id",
    "reviewed_at",
    "evidence_snapshot_id",
    "decision",
    "rationale",
    "changes_made",
    "resulting_policy_version"
  ],
  "properties": {
    "schema_version": {"const": "human-review.v1"},
    "review_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "evidence_snapshot_id": {"type": "string", "minLength": 1},
    "decision": {
      "enum": [
        "allow",
        "conditional",
        "blocked",
        "rejected",
        "reconsidered"
      ]
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "changes_made": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "resulting_policy_version": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
