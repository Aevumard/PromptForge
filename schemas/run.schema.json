{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptforge://schemas/run.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "arm_id",
    "transform_id",
    "transform_sequence",
    "metrics",
    "verification",
    "quality_pass"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.6"},
    "run_id": {"type": "string"},
    "timestamp_utc": {"type": "string"},
    "task_id": {"type": "string"},
    "task_family": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "arm_id": {"type": "string"},
    "transform_id": {"type": "string"},
    "transform_sequence": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "repetition": {"type": "integer", "minimum": 1},
    "context_change": {"type": "object"},
    "metrics": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens",
        "latency_ms"
      ],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": ["number", "integer"], "minimum": 0}
      }
    },
    "execution": {"type": "object"},
    "verification": {"type": "object"},
    "quality_pass": {"type": "boolean"},
    "raw_text": {},
    "output": {}
  },
  "additionalProperties": true
}
