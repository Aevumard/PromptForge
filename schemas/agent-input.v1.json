{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aevumard/PromptForge/blob/main/schemas/agent-input.v1.json",
  "title": "PromptForge Agent Input v1",
  "type": "object",
  "required": [
    "schema_version",
    "context",
    "context_tokens",
    "budget_tokens",
    "tokens_saved",
    "deferred_catalog",
    "tool_outputs",
    "tool_output_chars_saved",
    "tool_output_tokens_saved",
    "total_estimated_savings",
    "omitted_context_ids"
  ],
  "properties": {
    "schema_version": {"const": "agent-input.v1"},
    "context": {"type": "object"},
    "context_tokens": {"type": "integer", "minimum": 0},
    "budget_tokens": {"type": "integer", "minimum": 1},
    "tokens_saved": {"type": "integer", "minimum": 0},
    "deferred_catalog": {"type": "object"},
    "tool_outputs": {"type": "array"},
    "tool_output_chars_saved": {"type": "integer", "minimum": 0},
    "tool_output_tokens_saved": {"type": "integer", "minimum": 0},
    "total_estimated_savings": {"type": "integer", "minimum": 0},
    "omitted_context_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
