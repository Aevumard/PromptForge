{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aevumard/PromptForge/blob/main/schemas/action-execution.v1.json",
  "title": "PromptForge Action Execution v1",
  "type": "object",
  "required": [
    "schema_version",
    "execution_id",
    "action_id",
    "idempotency_key",
    "status",
    "attempt",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "action-execution.v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "status": {"enum": ["started", "succeeded", "failed", "skipped"]},
    "attempt": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "external_reference": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
